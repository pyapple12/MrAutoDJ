{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MrAutoDJ",
  "version": "0.2.9",
  "identifier": "com.pyapple12.mrautodj",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../webui/dist",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "MrAutoDJ",
        "width": 1600,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
